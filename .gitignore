# --- SECRETS — never commit these ---
.env
.flask_secret
owner_auth.json
# Keys for by-link pages. On Render these live in /var/data, but running
# locally without that disk writes them here — and this repo is public, so a
# committed key would hand the link to everyone.
share_keys.json
# Bot lab. bot_users.json holds password hashes for owner-issued accounts;
# the other two are the record and the lock state. Same story as above — on
# Render these live in /var/data, but a local run writes them here, and this
# repo is public.
bot_users.json
bot_ledger.json
bot_locks.json
*.pem
*.key

# --- private uploads / PII ---
insurance_uploads/
documents/
board_docs/
board_docs.json
board_members.json

