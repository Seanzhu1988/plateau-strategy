__pycache__/
*.pyc
.DS_Store
.venv/
venv/
backups/
clock_signups.json
give_back.json
visit_times.json
guide_offers.json
robotaxi_interest.json

# The idea board's store. Public content by design, but still user-submitted
# runtime data — and a tracked copy is how Sean's own June test post ended up
# committed and needing deletion later (#20260630210246). A fresh deploy with
# no file starts as an empty board, which is correct.
articles.json

# --- runtime data with customer / business PII — NEVER commit or upload ---
reservations.json
customers.json
renters.json
agents.json
owner_alerts.json
contract_signatures.json
finance_signups.json
finance_wishlist.json
deflator_waitlist.json
partners.json
documents.json
violations.json
traffic.json
app.log

# --- sensitive: bank statements, archives, logs, temp — NEVER commit ---
*.pdf
*.zip
*.tar.gz
*.log
booking_app.log
zibS3LVQ
place_ratings.json
travel_wishes.json
destination_comments.json
ride_demand.json
board_auth.json
guide_trips.json
guide_interest.json

# Converted copies of licences and filings — the source PDFs are already
# ignored above, and the JPGs carry the same identifiers, so they must not
# reach a repo that gets deployed to a public site.
jpg-out/

# Coarsened location cache — visitor-derived, never committed.
geo_cache.json

# The consent ledger and what people contributed under it. The ledger is the
# proof of who agreed to what and when; committing it would publish a record
# of people's choices, and committing the contributions would publish the
# places they added. On Render both live in /var/data, but a local run writes
# them here and this repo is public.
consents.json
place_contributions.json

# Route demand. Counts only — no person is in this file by construction — but
# it is still the business's own demand data, and on Render it lives in
# /var/data. A local run writes it here and this repo is public.
route_demand.json

# Footprints — recorded walks of our own corridors. The only file holding
# metre-level GPS traces (geo_cache.json above keeps km-coarse city centroids,
# a different kind of thing). They map public walkways, not people, but they
# are survey work the business paid for with shoe leather, and the repo is
# public. The .tmp twin matters just as much: the atomic write dumps the FULL
# store there before os.replace, so a crash mid-write strands every trace in
# an un-ignored file one `git add -A` from publication.
footprints.json
footprints.json.tmp

# Networks the owner registered as "this is me, do not count it". Home and
# office IP addresses — the owner's own location, which is not something to
# publish in a public repo.
traffic_ignore.json

professions.json
pros.json
opinions.json
purchases.json

# One-time seed marker: which shipped articles have been placed and must not
# resurrect after deletion. Runtime state, lives on the data disk.
seeded_articles.json
