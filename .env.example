# Plateau Strategy Solution Lab booking app — configuration
# Copy this file to ".env" and fill in values. The app runs in DEMO mode
# (simulated invoices, no email/SMS) until you add real credentials.

# ---- Square (invoicing) ----
# Get these from https://developer.squareup.com  (see SQUARE_SETUP.md)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox          # sandbox = test mode | production = real money
SQUARE_CURRENCY=USD

# ---- Driver notifications ----
DRIVER_EMAIL=               # driver's email (for Resend email alerts)
OWNER_PHONE=                # your phone in E.164, e.g. +12065550100
DRIVER_PHONE=               # driver's phone in E.164, e.g. +14155550199

# ---- Email via Resend (optional) ----
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Plateau Strategy Solution Lab <onboarding@resend.dev>

# ---- SMS via Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                # your Twilio number, E.164

# ---- App ----
PORT=8080
DEFAULT_FARE_USD=75
DEFAULT_COMMISSION_PCT=0.10   # agent commission per referral (0.10 = 10%)

# ---- PayPal Payouts (one-click agent payouts from Dispatch) ----
# Create an app at developer.paypal.com > Apps & Credentials.
# Start in sandbox; switch PAYPAL_ENV=live only after a proven sandbox test.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Universal Gallery ----
# Configure a website-owned key privately on the host. Never commit a key.
# Saved artifacts and stories remain readable when this is blank.
ANTHROPIC_API_KEY=
GALLERY_MODEL=claude-sonnet-5
GALLERY_VISION_MODEL=claude-sonnet-5
# Caps count attempted provider calls, including uncertain failures.
GALLERY_MONTHLY_CAP=1500
GALLERY_IDENTIFY_MONTHLY_CAP=500
GALLERY_IDENTIFY_HOURLY_LIMIT=12
# Optional confirmed visitor photographs, separately permissioned and credited.
GALLERY_PHOTO_HOURLY_LIMIT=12
GALLERY_PHOTO_MAX_PER_ARTIFACT=3
GALLERY_PHOTO_STORAGE_BYTES=134217728
GALLERY_RESEARCH_HOURLY_LIMIT=12
# Production uses its existing persistent disk. Do not point this at /tmp.
# DATA_DIR=/var/data
# Existing discovery scheduler supplies the bounded hourly writing tick.
# DISCOVERY_ENABLED=true
