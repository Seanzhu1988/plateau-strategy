# Plateau Strategy Solution Lab booking app — configuration
# Copy this file to ".env" and fill in values. The app runs in DEMO mode
# (simulated invoices, no email/SMS) until you add real credentials.

# ---- Square (invoicing) ----
# Get these from https://developer.squareup.com  (see SQUARE_SETUP.md)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox          # sandbox = test mode | production = real money
SQUARE_CURRENCY=USD

# ---- Driver notifications ----
DRIVER_EMAIL=               # driver's email (for Resend email alerts)
OWNER_PHONE=+19175886013
DRIVER_PHONE=               # driver's phone in E.164, e.g. +14155550199

# ---- Email via Resend (optional) ----
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=Plateau Strategy Solution Lab <onboarding@resend.dev>

# ---- SMS via Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                # your Twilio number, E.164

# ---- App ----
PORT=8080
DEFAULT_FARE_USD=75
DEFAULT_COMMISSION_PCT=0.10   # agent commission per referral (0.10 = 10%)

# ---- PayPal Payouts (one-click agent payouts from Dispatch) ----
# Create an app at developer.paypal.com > Apps & Credentials.
# Start in sandbox; switch PAYPAL_ENV=live only after a proven sandbox test.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
